rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /profile/{profileID} {
        allow read, create, update, delete: if isOwner(uid) && profileID == "main";
      }

      match /journalEntries/{entryID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /aiReflectionSessions/{sessionID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /quests/{questID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /tipsPracticeSessions/{sessionID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /rewardState/{rewardStateID} {
        allow read, create, update, delete: if isOwner(uid) && rewardStateID == "main";
      }

      match /pointEntries/{pointEntryID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /activityEvents/{activityEventID} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // Public circles: every signed-in user can read the global list. Writes are restricted:
    // - create: caller must stamp themselves as the creator
    // - update: the creator may edit metadata; any other signed-in user may change only
    //           their own entry in memberUserIDs, likedByUserIDs and favoritedByUserIDs,
    //           and nothing else
    // - delete: only the creator
    match /circles/{circleID} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorUserID == request.auth.uid;

      // Arrays the app may leave absent on create.
      function before(field) { return resource.data.get(field, []); }
      function after(field) { return request.resource.data.get(field, []); }

      // True when `field` differs from the stored value only by the caller's own uid being
      // added or removed, in any position, or is unchanged.
      function onlyOwnEntryChanged(field) {
        return after(field) is list
          && after(field).removeAll([request.auth.uid]) == before(field).removeAll([request.auth.uid])
          && (after(field).removeAll([request.auth.uid]).size() == after(field).size()
              || after(field).removeAll([request.auth.uid]).size() == after(field).size() - 1);
      }

      function onlyMembershipFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUserIDs', 'likedByUserIDs', 'favoritedByUserIDs']);
      }

      allow update: if isSignedIn() && (
        resource.data.creatorUserID == request.auth.uid
        && request.resource.data.creatorUserID == resource.data.creatorUserID
        || (
          onlyMembershipFieldsChanged()
          && onlyOwnEntryChanged('memberUserIDs')
          && onlyOwnEntryChanged('likedByUserIDs')
          && onlyOwnEntryChanged('favoritedByUserIDs')
        )
      );

      allow delete: if isSignedIn() && resource.data.creatorUserID == request.auth.uid;

      function isCircleMember() {
        return isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleID)).data.get('memberUserIDs', []);
      }

      // Posts: public read, member-gated create. The author may edit or delete the post.
      // Anyone else signed in may change only `likedBy` (their own entry) and `replies`.
      //
      // Replies are stored as an array on the post and written back whole, so the rules
      // language (no loops) cannot check each reply's author on a non-author write. What it
      // can hold: the reply count changes by at most one per write, and the author/text/
      // createdAt/who of the post itself never change. Per-reply ownership needs replies in
      // a subcollection; see the 31 October audit follow-up.
      match /posts/{postID} {
        allow read: if isSignedIn();

        allow create: if isCircleMember()
          && request.resource.data.authorUserID == request.auth.uid;

        function pBefore(field) { return resource.data.get(field, []); }
        function pAfter(field) { return request.resource.data.get(field, []); }

        function onlyOwnLikeChanged() {
          return pAfter('likedBy').removeAll([request.auth.uid]) == pBefore('likedBy').removeAll([request.auth.uid])
            && (pAfter('likedBy').removeAll([request.auth.uid]).size() == pAfter('likedBy').size()
                || pAfter('likedBy').removeAll([request.auth.uid]).size() == pAfter('likedBy').size() - 1);
        }

        function repliesChangeByAtMostOne() {
          return pAfter('replies') is list
            && pAfter('likedBy') is list
            && pAfter('replies').size() >= pBefore('replies').size() - 1
            && pAfter('replies').size() <= pBefore('replies').size() + 1;
        }

        function appendedReplyIsOwn() {
          return pAfter('replies').size() != pBefore('replies').size() + 1
            || pAfter('replies')[pAfter('replies').size() - 1].get('authorUserID', '') == request.auth.uid;
        }

        allow update: if isSignedIn() && (
          resource.data.authorUserID == request.auth.uid
          && request.resource.data.authorUserID == resource.data.authorUserID
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'replies'])
            && onlyOwnLikeChanged()
            && repliesChangeByAtMostOne()
            && appendedReplyIsOwn()
          )
        );

        allow delete: if isSignedIn() && resource.data.authorUserID == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, create, update, delete: if false;
    }
  }
}
