rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /profile/{profileID} {
        allow read, create, update, delete: if isOwner(uid) && profileID == "main";
      }

      match /journalEntries/{entryID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /aiReflectionSessions/{sessionID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /quests/{questID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /tipsPracticeSessions/{sessionID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /rewardState/{rewardStateID} {
        allow read, create, update, delete: if isOwner(uid) && rewardStateID == "main";
      }

      match /pointEntries/{pointEntryID} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /activityEvents/{activityEventID} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // Public circles: every signed-in user can read the global list. Writes are restricted:
    // - create: caller must stamp themselves as the creator
    // - update: the creator may edit metadata; any other signed-in user may change only
    //           their own entry in memberUserIDs, likedByUserIDs and favoritedByUserIDs,
    //           and nothing else
    // - delete: only the creator
    match /circles/{circleID} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorUserID == request.auth.uid;

      // True when `field` differs from the stored value only by the caller's own uid
      // being added or removed (or is unchanged).
      function onlyOwnEntryChanged(field) {
        return request.resource.data[field] == resource.data[field]
          || (
            request.resource.data[field] == resource.data[field].concat([request.auth.uid])
            && !(request.auth.uid in resource.data[field])
          )
          || (
            resource.data[field] == request.resource.data[field].concat([request.auth.uid])
            && !(request.auth.uid in request.resource.data[field])
          );
      }

      function onlyMembershipFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUserIDs', 'likedByUserIDs', 'favoritedByUserIDs']);
      }

      allow update: if isSignedIn() && (
        resource.data.creatorUserID == request.auth.uid
        && request.resource.data.creatorUserID == resource.data.creatorUserID
        || (
          onlyMembershipFieldsChanged()
          && onlyOwnEntryChanged('memberUserIDs')
          && onlyOwnEntryChanged('likedByUserIDs')
          && onlyOwnEntryChanged('favoritedByUserIDs')
        )
      );

      allow delete: if isSignedIn() && resource.data.creatorUserID == request.auth.uid;

      function isCircleMember() {
        return isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleID)).data.memberUserIDs;
      }

      // Posts: public read, member-gated create. The author may edit or delete. Anyone else
      // signed in may change only their own like, or append exactly one reply they authored.
      match /posts/{postID} {
        allow read: if isSignedIn();

        allow create: if isCircleMember()
          && request.resource.data.authorUserID == request.auth.uid;

        function unchangedExcept(keys) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
        }

        function onlyOwnLikeChanged() {
          return request.resource.data.likedBy == resource.data.likedBy
            || (
              request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid])
              && !(request.auth.uid in resource.data.likedBy)
            )
            || (
              resource.data.likedBy == request.resource.data.likedBy.concat([request.auth.uid])
              && !(request.auth.uid in request.resource.data.likedBy)
            );
        }

        function appendsOneOwnReply() {
          return request.resource.data.replies.size() == resource.data.replies.size() + 1
            && request.resource.data.replies[0:resource.data.replies.size()] == resource.data.replies
            && request.resource.data.replies[resource.data.replies.size()].authorUserID == request.auth.uid;
        }

        allow update: if isSignedIn() && (
          resource.data.authorUserID == request.auth.uid
          && request.resource.data.authorUserID == resource.data.authorUserID
          || (
            unchangedExcept(['likedBy', 'replies'])
            && onlyOwnLikeChanged()
            && (request.resource.data.replies == resource.data.replies || appendsOneOwnReply())
          )
        );

        allow delete: if isSignedIn() && resource.data.authorUserID == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, create, update, delete: if false;
    }
  }
}
